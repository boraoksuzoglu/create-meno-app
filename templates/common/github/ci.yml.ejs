name: CI

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main, develop]

jobs:
  test:
    name: Test & Lint
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci
<% if (includeEslint) { -%>

      - name: Lint
        run: npm run lint
<% } -%>
      - name: Security audit
        run: npm audit --audit-level=high
<% if (includeMdDocs) { -%>

      # Fails if committed docs/ is stale. Passes (skips) until you first run
      # `npm run docs` and commit the docs/ folder.
      - name: Check docs are up to date
        run: npm run docs -- --check
<% } -%>
<% if (includeJest) { -%>

      - name: Run tests
        run: npm test
        env:
          NODE_ENV: test
<% } -%>
<% if (isTs) { -%>

      - name: Build TypeScript
        run: npm run build
<% } -%>
