<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Password</title>
  <style type="text/css">
    @media only screen and (max-width: 640px) {
      .email-card { width: 100% !important; }
      .email-pad  { padding: 24px 20px !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background-color:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f4f4f5">
  <tr><td align="center" style="padding:32px 16px;">
    <table class="email-card" width="600" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff"
      style="background-color:#ffffff;border-radius:16px;overflow:hidden;max-width:600px;">
      <tr><td height="4" bgcolor="#6366f1" style="background-color:#6366f1;font-size:0;line-height:0;">&nbsp;</td></tr>

      <tr>
        <td class="email-pad" style="padding:32px 40px 20px;">
          <p style="margin:0 0 20px 0;font-size:20px;font-weight:700;color:#6366f1;letter-spacing:-0.02em;">{{appName}}</p>
          <h1 style="margin:0 0 6px 0;font-size:26px;font-weight:700;color:#18181b;line-height:1.25;">{{t.title}}</h1>
          <p style="margin:0;font-size:15px;color:#71717a;">{{t.subtitle}}</p>
        </td>
      </tr>
      <tr><td style="padding:0 40px;"><table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr><td height="1" bgcolor="#e4e4e7" style="background-color:#e4e4e7;font-size:0;line-height:0;">&nbsp;</td></tr>
      </table></td></tr>
      <tr>
        <td class="email-pad" style="padding:28px 40px 0;">
          <p style="margin:0 0 16px 0;font-size:15px;color:#18181b;line-height:1.6;">{{t.greeting}}</p>
          <p style="margin:0 0 24px 0;font-size:15px;color:#18181b;line-height:1.6;">{{t.body}}</p>
        </td>
      </tr>
      <tr><td align="center" style="padding:0 40px 24px;">
    <table cellpadding="0" cellspacing="0" border="0"><tr>
      <td align="center" bgcolor="#6366f1" style="background-color:#6366f1;border-radius:10px;">
        <a href="{{ctaUrl}}" style="display:inline-block;padding:14px 36px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:10px;">{{t.buttonText}}</a>
      </td>
    </tr></table>
  </td></tr>
      <tr>
        <td style="padding:0 40px 24px;">
          <table width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#fef3c7"
            style="background-color:#fef3c7;border-radius:10px;border-left:3px solid #f59e0b;">
            <tr><td style="padding:14px 16px;">
              <p style="margin:0 0 6px 0;font-size:13px;color:#18181b;line-height:1.55;">⏱ {{t.expiryNote}}</p>
              <p style="margin:0;font-size:13px;color:#78716c;line-height:1.55;">{{t.ignoreNote}}</p>
            </td></tr>
          </table>
        </td>
      </tr>
      <tr>
        <td class="email-pad" style="padding:0 40px 32px;">
          <p style="margin:0;font-size:15px;color:#18181b;line-height:1.6;">{{t.teamSignature}}<br><strong>{{t.teamName}}</strong></p>
        </td>
      </tr>

      <tr>
        <td bgcolor="#fafafa" style="background-color:#fafafa;border-top:1px solid #e4e4e7;padding:20px 40px;text-align:center;">
          <p style="margin:0 0 4px 0;font-size:12px;color:#a1a1aa;">{{t.sentToPrefix}} <strong>{{userEmail}}</strong>{{t.sentToSuffix}}</p>
          <p style="margin:0;font-size:12px;color:#a1a1aa;">&copy; {{currentYear}} {{appName}}. {{t.copyright}}</p>
        </td>
      </tr>

    </table>
  </td></tr>
</table>
</body>
</html>