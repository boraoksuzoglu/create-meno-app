import databaseConnection from '@/utils/database.js';
<% if (includeLogger) { -%>
import logger from '@/utils/logger.js';
<% } -%>

const SHUTDOWN_TIMEOUT_MS = 10_000;

/**
 * Graceful Shutdown
 * ──────────────────
 * Listens for SIGTERM and SIGINT (Docker stop, Ctrl+C, Kubernetes pod eviction).
 *
 * On signal:
 *  1. Stop accepting new connections (server.close)
 *  2. Wait for in-flight requests to finish (up to SHUTDOWN_TIMEOUT_MS)
 *  3. Close MongoDB connection
 *  4. Exit cleanly with code 0
 *
 * If shutdown takes too long, forces exit with code 1.
 *
 * @param server - The http.Server instance returned by app.listen()
 */
export const registerGracefulShutdown = (server) => {
  const shutdown = async (signal) => {
<% if (includeLogger) { -%>
    logger.info('SHUTDOWN_INITIATED', { signal });
<% } else { -%>
    console.log('[Shutdown] SHUTDOWN_INITIATED');
<% } -%>

    // Force-exit if graceful shutdown takes too long
    const forceExit = setTimeout(() => {
<% if (includeLogger) { -%>
      logger.info('SHUTDOWN_TIMEOUT', {});
<% } else { -%>
      console.log('[Shutdown] SHUTDOWN_TIMEOUT');
<% } -%>
      process.exit(1);
    }, SHUTDOWN_TIMEOUT_MS);
    forceExit.unref(); // don't keep the event loop alive just for this timer

    try {
      // 1. Stop accepting new HTTP connections
      await new Promise((resolve, reject) =>
        server.close((err) => (err ? reject(err) : resolve()))
      );
<% if (includeLogger) { -%>
      logger.info('HTTP_SERVER_CLOSED', {});
<% } else { -%>
      console.log('[Shutdown] HTTP_SERVER_CLOSED');
<% } -%>

      // 2. Close database connection
      await databaseConnection.disconnect();
<% if (includeLogger) { -%>
      logger.info('DATABASE_DISCONNECTED', {});
<% } else { -%>
      console.log('[Shutdown] DATABASE_DISCONNECTED');
<% } -%>

      clearTimeout(forceExit);
<% if (includeLogger) { -%>
      logger.info('SHUTDOWN_COMPLETE', {});
<% } else { -%>
      console.log('[Shutdown] SHUTDOWN_COMPLETE');
<% } -%>
      process.exit(0);
    } catch (err) {
<% if (includeLogger) { -%>
      logger.info('SHUTDOWN_ERROR', { error: err?.message });
<% } else { -%>
      console.log('[Shutdown] SHUTDOWN_ERROR');
<% } -%>
      process.exit(1);
    }
  };

  process.on('SIGTERM', () => shutdown('SIGTERM'));
  process.on('SIGINT',  () => shutdown('SIGINT'));
};
