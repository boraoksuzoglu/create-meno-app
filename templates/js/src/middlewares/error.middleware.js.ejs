import createError from 'http-errors';
import { config } from '@/config/config.js';
<% if (includeLogger) { -%>
import { logError, logWarning } from '@/utils/logger.js';
<% } -%>

export const notFound = (req, res, next) => {
  next(createError(404, 'NOT_FOUND'));
};

export const errorHandler = (err, req, res, _next) => {
  const statusCode = err.status || 500;

  if (statusCode >= 500) {
<% if (includeLogger) { -%>
    logError(err, { method: req.method, url: req.url, ip: req.ip });
<% } else { -%>
    console.error(err);
<% } -%>
  } else if (statusCode === 401 || statusCode === 403) {
<% if (includeLogger) { -%>
    logWarning(err.message, { method: req.method, url: req.url, ip: req.ip });
<% } else { -%>
    console.warn(err.message);
<% } -%>
  }

  const response = {
    status: statusCode,
    message: err.message || 'INTERNAL_SERVER_ERROR',
  };

  if (err.data) response.data = err.data;
  if (!config.app.isProduction && err.stack) response.stack = err.stack;

  res.status(statusCode).json(response);
};
